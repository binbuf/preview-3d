<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!--
    Shared C++ build policy for every project in Preview3D.slnx.
    See .docs/design/10-delivery-plan.md ("Repository transition"): C++20,
    Unicode, conformance mode, /permissive-, warning level 4, and
    warnings-as-errors for product code live here instead of drifting
    between per-project .vcxproj files.

    A hostile-worker attack binary (Gate 2's synthetic containment-test
    build) sets IsHostileTestBinary=true in its own .vcxproj to opt out of
    TreatWarningsAsErrors only; it still gets every other policy here.
  -->
  <PropertyGroup>
    <WindowsTargetPlatformVersion Condition="'$(WindowsTargetPlatformVersion)'==''">10.0</WindowsTargetPlatformVersion>
    <PlatformToolset Condition="'$(PlatformToolset)'==''">v145</PlatformToolset>
    <CharacterSet Condition="'$(CharacterSet)'==''">Unicode</CharacterSet>
    <!-- EH continuation metadata is off until the pinned libraries ship it. -->
    <Preview3DEnableGuardEhCont Condition="'$(Preview3DEnableGuardEhCont)'==''">false</Preview3DEnableGuardEhCont>
  </PropertyGroup>

  <!--
    vcpkg opt-in. A project that consumes a vcpkg dependency declares

      <PropertyGroup Label="Vcpkg">
        <VcpkgEnableManifest>true</VcpkgEnableManifest>
      </PropertyGroup>

    above its Microsoft.Cpp.Default.props import (Preview3DImportWorker,
    Tests.Unit and Tests.ImportIsolation do). Everything else is turned off
    explicitly here rather than left unset.

    Unset is not the same as off: vcpkg defaults VcpkgEnabled to true, finds
    vcpkg.json at the repo root, and prints "The vcpkg manifest was disabled,
    but we found a manifest file in ..." once per project per build. That is
    pure noise for a project that has no vcpkg dependency, and noise in a
    build log is what let a real defect hide in plain sight (see
    .docs/PROGRESS.md, "Release vcpkg DLLs in x64\Debug").

    This changes no build inputs. Those projects already resolved
    _ZVcpkgClassicOrManifest to false, so they were already getting no vcpkg
    include directories, no autolink and no app-local deployment; this only
    stops vcpkg from asking about it. Turning manifests *on* for them would
    not be equivalent: vcpkg autolink appends the whole triplet's lib\*.lib
    to the link line, including the 52 MB basisu_encoder.lib.

    Ordering note: this file is imported (via Microsoft.Common.props, from
    Microsoft.Cpp.Default.props) after a project's own Label="Vcpkg" property
    group is evaluated but before vcpkg.props applies its defaults, so the
    per-project opt-in above still wins.

    Adding a project that needs a vcpkg library? Set VcpkgEnableManifest as
    shown. Forgetting to shows up immediately as an unresolved #include, not
    as a subtle misconfiguration.
  -->
  <PropertyGroup>
    <VcpkgEnabled Condition="'$(VcpkgEnabled)'=='' and '$(VcpkgEnableManifest)'!='true'">false</VcpkgEnabled>
  </PropertyGroup>

  <!--
    Static dependency closure.

    The release payload must not contain upstream DLLs. Windows Smart App
    Control evaluates every executable image separately, and SignPath
    Foundation's free certificate may only sign this project's own binaries, so
    an unsigned zstd.dll/draco.dll/usd_ms.dll/TK*.dll would still be blocked
    even after the app itself is signed. VcpkgUseStatic + VcpkgUseMD select the
    x64-windows-static-md triplet (static vcpkg libraries, dynamic
    Microsoft-signed CRT), leaving only Preview3D.exe, Preview3DImportWorker.exe,
    Preview3DImportHost.exe, Preview3DOpenUsdCore.dll, and
    Preview3DStepHost.exe as executable images.

    The projects that consume vcpkg hardcode the matching
    vcpkg_installed\x64-windows-static-md directory in VcpkgInstalledDir,
    because that property is evaluated before this file is imported.
  -->
  <PropertyGroup>
    <VcpkgUseStatic Condition="'$(VcpkgUseStatic)'==''">true</VcpkgUseStatic>
    <VcpkgUseMD Condition="'$(VcpkgUseMD)'==''">true</VcpkgUseMD>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <ConformanceMode>true</ConformanceMode>
      <WarningLevel>Level4</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <!--
        Consumer-side defines for the statically linked dependency closure.
        vcpkg's CMake configs normally publish these through
        INTERFACE_COMPILE_DEFINITIONS, but MSBuild consumes vcpkg through
        autolink only, so the static variants have to be set here:
          PXR_STATIC      OpenUSD's single global (see pxr/base/arch/export.h)
          KHRONOS_STATIC  ktx/KHRONOS public API
          KTX_FEATURE_*   features the ktx static lib was built with
          SIMDJSON_THREADS_ENABLED=1, ZIP_STATIC  as in the vcpkg static configs
        They are inert for projects that do not include those headers.
      -->
      <PreprocessorDefinitions>PXR_STATIC;KHRONOS_STATIC;BASISU_NO_ITERATOR_DEBUG_LEVEL;KTX_FEATURE_KTX1;KTX_FEATURE_KTX2;KTX_FEATURE_WRITE;SIMDJSON_THREADS_ENABLED=1;ZIP_STATIC;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalOptions>/permissive- /utf-8 %(AdditionalOptions)</AdditionalOptions>
      <!-- TreatWarningAsError (not the .NET-SDK-style "TreatWarningsAsErrors"
           property, which has no effect on VC++ ClCompile) is the actual
           /WX switch here. -->
      <TreatWarningAsError Condition="'$(IsHostileTestBinary)'!='true'">true</TreatWarningAsError>
      <!--
        Process-wide and per-image hardening for every product binary
        (viewer, worker, both import hosts, Preview3DOpenUsdCore.dll, the
        thumbnail provider, and the test executables that link the same
        sources). The thumbnail provider previously set CFG and CET itself;
        those settings are now the shared default and the provider keeps them
        only for documentation. See ADR-0039.

        /guard:cf (ControlFlowGuard) and /guard:ehcont (GuardEHContMetadata)
        are compiler switches; Microsoft.CppCommon.targets derives the matching
        linker /GUARD:CF and /GUARD:EHCONT from the ClCompile metadata, so no
        explicit linker property is needed.
      -->
      <ControlFlowGuard>Guard</ControlFlowGuard>
      <!--
        /guard:ehcont is opt-in because the linker refuses to emit an image
        whose imported objects lack EH continuation metadata (LNK1386/LNK2047),
        and the pinned third-party static libraries (TinyUSDZ, ufbx, zip, zstd,
        draco, ktx, lib3mf, libwebp, meshoptimizer, simdjson, tbb, OpenUSD, ...)
        were built without it. Measured with this toolset: the worker, the
        viewer, and the provider all fail to link with those errors, so the
        policy cannot be part of the shared default yet. Set
        Preview3DEnableGuardEhCont=true once the vcpkg ports are rebuilt with
        /guard:ehcont; the switch then flows to the compiler and the linker
        exactly as CFG does. See ADR-0039.
      -->
      <GuardEHContMetadata Condition="'$(Preview3DEnableGuardEhCont)' == 'true'">true</GuardEHContMetadata>
    </ClCompile>
    <Link>
      <!-- /CETCOMPAT: mark the image compatible with CET shadow stacks. -->
      <CETCompat>true</CETCompat>
    </Link>
    <Manifest>
      <EnableSegmentHeap>true</EnableSegmentHeap>
      <!--
        longPathAware, activeCodePage UTF-8, and explicit supportedOS entries.
        mt.exe merges this with the linker-generated manifest, so the segment
        heap, UAC trustInfo, and this file's WindowsSettings coexist.
      -->
      <AdditionalManifestFiles>$(MSBuildThisFileDirectory)shared\platform\app.manifest;%(AdditionalManifestFiles)</AdditionalManifestFiles>
    </Manifest>
  </ItemDefinitionGroup>

  <!--
    Fault/harness hooks (hang, crash, overallocate, child-noop, test-import
    fault modes, delayed-batch parsing, ...) ship only in Debug. A Release
    build is a production binary: it rejects every fault mode with a usage
    exit, because the code paths are not compiled in. The restriction and
    fault-recovery tests that need these modes are gated on the same macro and
    are skipped (not failed) in Release; a Release-only test asserts the
    rejection. See T09 (SEC-09) and ADR-0038.
  -->
  <ItemDefinitionGroup Condition="'$(Configuration)' == 'Debug'">
    <ClCompile>
      <PreprocessorDefinitions>PREVIEW3D_ENABLE_FAULT_HARNESS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- /guard:cf is incompatible with /ZI (Edit and Continue). The MSBuild
           default is already /Zi (ProgramDatabase), but state it explicitly so
           a future project template cannot reintroduce /ZI and break the
           shared CFG policy. The thumbnail provider documented this
           interaction before CFG moved here. -->
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
