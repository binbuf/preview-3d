  <PropertyGroup Label="Vcpkg">
    <!-- The dedicated STEP host owns the constrained OCCT closure. It is
         deliberately isolated from the repository-root manifest so the
         viewer, general worker, and thumbnail provider can never link or
         deploy OCCT. STEP-001 already installed this closure; the manifest
         install is disabled so an ordinary solution build never rebuilds a
         multi-hour CAD kernel, and STEP-003 re-enables the repository
         baseline pin when the toolchain matches. -->
    <VcpkgEnableManifest>true</VcpkgEnableManifest>
    <VcpkgManifestRoot>$(MSBuildThisFileDirectory)</VcpkgManifestRoot>
    <VcpkgManifestInstall>false</VcpkgManifestInstall>
    <VcpkgInstalledDir>$(MSBuildThisFileDirectory)vcpkg_installed\</VcpkgInstalledDir>
