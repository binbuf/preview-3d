<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!--
    Companion to Directory.Build.props, imported at the end of every
    project's evaluation via Microsoft.Cpp.targets. This is the deliberate
    hook point for build-policy targets called for in
    .docs/design/10-delivery-plan.md, rather than growing ad hoc per-project
    post-build steps.
  -->

  <!--
    /Qspectre is enabled only when the optional "MSVC Spectre-mitigated
    libraries" component is installed. MSBuild raises MSB8040 when
    SpectreMitigation is set without those libraries, and most workstations
    (including this repository's CI image) do not install them, so enabling it
    unconditionally would break the documented build. The detection runs here
    rather than in Directory.Build.props because VC_LibraryPath_* is not
    computed until Microsoft.Cpp.props has been imported.

    Preview3DSpectreMitigationEnabled records the measured outcome so the
    hand-off and tests can assert which mitigations a given machine produced.
  -->
  <PropertyGroup>
    <Preview3DSpectreLibsPresent Condition="Exists('$(VC_LibraryPath_VC_Desktop_CurrentPlatform_spectre)')">true</Preview3DSpectreLibsPresent>
    <Preview3DSpectreLibsPresent Condition="'$(Preview3DSpectreLibsPresent)' == ''">false</Preview3DSpectreLibsPresent>
    <Preview3DSpectreMitigationEnabled Condition="'$(Preview3DSpectreLibsPresent)' == 'true' or '$(SpectreMitigation)' == 'Spectre'">true</Preview3DSpectreMitigationEnabled>
    <Preview3DSpectreMitigationEnabled Condition="'$(Preview3DSpectreMitigationEnabled)' == ''">false</Preview3DSpectreMitigationEnabled>
    <SpectreMitigation Condition="'$(Preview3DSpectreLibsPresent)' == 'true' and ('$(SpectreMitigation)' == '' or '$(SpectreMitigation)' == 'false')">Spectre</SpectreMitigation>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <SpectreMitigation Condition="'$(Preview3DSpectreLibsPresent)' == 'true' and ('%(ClCompile.SpectreMitigation)' == '' or '%(ClCompile.SpectreMitigation)' == 'false')">Spectre</SpectreMitigation>
    </ClCompile>
  </ItemDefinitionGroup>

  <!--
    Re-sync the vcpkg app-local DLLs in $(OutDir) with the ones for the
    configuration actually being built.

    Why this exists: every project in Preview3D.slnx shares one output
    directory ($(SolutionDir)x64\$(Configuration)), and vcpkg deploys its
    dependencies there by copying them next to the .exe. vcpkg's applocal.ps1
    only overwrites a DLL when the source is *newer* than what is already in
    $(OutDir):

        if ($sourceModTime -gt $destModTime) { Copy-Item ... }

    So a single release-configuration DLL that lands in x64\Debug (a manual
    copy while debugging, a tool script pulling from <triplet>\bin instead of
    <triplet>\debug\bin, an interrupted build) is never corrected. It just
    sits there, and every subsequent build silently keeps it.

    That is not a cosmetic problem on a dynamic triplet (the old x64-windows
    release; the shipped closure is now static), where a
    release DLL is /MD (_ITERATOR_DEBUG_LEVEL=0) while a Debug .exe is /MDd
    (_ITERATOR_DEBUG_LEVEL=2). MSVC's std::vector carries an extra
    _Container_proxy pointer under IDL!=0, so it is 32 bytes in the .exe's
    view and 24 in the DLL's. Any object passed across that boundary is read
    at the wrong offsets: fastgltf::Asset came back from a "successful"
    loadGltfBinary with scenes/nodes/meshes all zero and a garbage vector
    size, then corrupted the heap on teardown. The same mismatch produced
    heap-corruption crashes through draco.dll.

    The failure gives no diagnostic and survives source reverts, which makes
    it extremely expensive to bisect — it presents as a broken third-party
    parser. Copy with SkipUnchangedFiles so this is a no-op (a timestamp and
    size comparison, no I/O) on a healthy tree and self-heals a poisoned one.

    Scoped to DLL names vcpkg actually deployed here: we only refresh a file
    if a file of that name is already present in $(OutDir), so this never
    drags the whole vcpkg bin directory into the output.

    Gated on the same conditions as vcpkg's own AppLocalFromInstalled. That
    matters: when a project leaves VcpkgEnableManifest unset, vcpkg still
    computes _ZVcpkgCurrentInstalledDir, but points it at the *classic*
    install root inside the Visual Studio installation. Without this gate we
    would glob DLLs out of an unrelated tree.
  -->
  <Target Name="Preview3DResyncVcpkgAppLocalDlls"
          AfterTargets="AppLocalFromInstalled;AppLocalFromInstalledPreserve"
          Condition="'$(_ZVcpkgClassicOrManifest)' == 'true'
                     and '$(VcpkgApplocalDeps)' == 'true'
                     and '$(_ZVcpkgCurrentInstalledDir)' != ''
                     and '$(OutDir)' != ''">
    <ItemGroup>
      <!-- $(_ZVcpkgConfigSubdir) is "debug\" for Debug and empty for Release,
           so this always names the bin directory matching this build. -->
      <_Preview3DVcpkgBinDll Include="$(_ZVcpkgCurrentInstalledDir)$(_ZVcpkgConfigSubdir)bin\*.dll" />
      <_Preview3DVcpkgDllToResync Include="@(_Preview3DVcpkgBinDll)"
                                  Condition="Exists('$(OutDir)%(Filename)%(Extension)')" />
    </ItemGroup>

    <!-- Deliberately silent. The Copy task reports skipped files in
         CopiedFiles alongside real ones, so there is no cheap, accurate way
         to log "this one was actually wrong" without an inline task; a
         message driven off CopiedFiles fires on every build and trains you
         to ignore it. The copy is the fix, and on a healthy tree
         SkipUnchangedFiles reduces it to a size and timestamp comparison. -->
    <Copy SourceFiles="@(_Preview3DVcpkgDllToResync)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Retries="2" />

    <!-- Keep IncrementalClean from treating these as orphaned outputs. -->
    <ItemGroup>
      <FileWrites Include="@(_Preview3DVcpkgDllToResync->'$(OutDir)%(Filename)%(Extension)')" />
    </ItemGroup>
  </Target>

  <!--
    Restore the two *isolated* vcpkg manifests that vcpkg/MSBuild integration
    does not install by itself.

    Why this exists: the root manifest (vcpkg.json) is restored by vcpkg's own
    VcpkgInstallManifestDependencies target whenever a consuming project has
    VcpkgEnableManifest=true. The STEP host and the thumbnail provider instead
    own separate OCCT closures:

      compatibility-host-step\vcpkg_installed        (owns Preview3DStepHost)
      thumbnail-provider\step-occt\vcpkg_installed   (read directly by the provider)

    The STEP host deliberately sets VcpkgManifestInstall=false so an ordinary
    build never re-runs the multi-hour CAD kernel restore, and no project
    manifest-installs the provider's step-occt tree at all. Both directories are
    gitignored, so a fresh clone has neither and the build fails with
    "cannot open include file 'BRepBndLib.hxx'". CI provisions them explicitly
    in .github/workflows/dependencies.yml; this makes a local "Build Solution"
    self-heal the same way.

    The restore runs at most once per tree: the target only fires while the OCCT
    headers are absent, and vcpkg's own binary cache under
    %LOCALAPPDATA%\vcpkg\archives makes later restores a no-op. The stock
    x64-windows-static-md triplet is used (not CI's release-only overlay
    triplet) so Debug builds get the debug half the provider expects.
  -->
  <Target Name="Preview3DRestoreIsolatedVcpkgManifests"
          BeforeTargets="ClCompile"
          Condition="'$(VcpkgRoot)' != '' and '$(DesignTimeBuild)' != 'true'
                     and (('$(MSBuildProjectName)' == 'Preview3DStepHost'
                           and !Exists('$(MSBuildThisFileDirectory)compatibility-host-step\vcpkg_installed\x64-windows-static-md\include\opencascade\Standard_Failure.hxx'))
                       or ('$(MSBuildProjectName)' == 'Preview3DThumbnailProvider'
                           and !Exists('$(MSBuildThisFileDirectory)thumbnail-provider\step-occt\vcpkg_installed\x64-windows-static-md\include\opencascade\Standard_Failure.hxx')))">
    <PropertyGroup>
      <_Preview3DVcpkgExe>$([System.IO.Path]::Combine('$(VcpkgRoot)','vcpkg.exe'))</_Preview3DVcpkgExe>
      <_Preview3DIsolatedManifestRoot Condition="'$(MSBuildProjectName)' == 'Preview3DStepHost'">$(MSBuildThisFileDirectory)compatibility-host-step</_Preview3DIsolatedManifestRoot>
      <_Preview3DIsolatedManifestRoot Condition="'$(MSBuildProjectName)' == 'Preview3DThumbnailProvider'">$(MSBuildThisFileDirectory)thumbnail-provider\step-occt</_Preview3DIsolatedManifestRoot>
    </PropertyGroup>

    <Error Condition="!Exists('$(_Preview3DVcpkgExe)')"
           Text="Preview 3D needs the isolated OCCT dependency tree under '$(_Preview3DIsolatedManifestRoot)', but vcpkg.exe was not found at '$(_Preview3DVcpkgExe)'. Run 'vcpkg integrate install' with the vcpkg you build with (see README 'Set up on a new workstation'), then rebuild." />

    <Message Importance="high"
             Text="Preview 3D: restoring isolated OCCT vcpkg manifest '$(_Preview3DIsolatedManifestRoot)\vcpkg.json'. The first restore compiles OCCT from source and can take ~30 minutes; later builds reuse the vcpkg archive cache." />

    <Exec Command="&quot;$(_Preview3DVcpkgExe)&quot; install --triplet x64-windows-static-md --x-manifest-root=&quot;$(_Preview3DIsolatedManifestRoot)&quot; --x-install-root=&quot;$(_Preview3DIsolatedManifestRoot)\vcpkg_installed&quot;" />
  </Target>
</Project>
