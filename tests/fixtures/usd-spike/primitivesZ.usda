#usda 1.0
(
    defaultPrim = "Primitives"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Primitives"
{
    def Sphere "Ball"
    {
        double radius = 0.5
        double3 xformOp:translate = (-4, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cube "Box"
    {
        double size = 1
        double3 xformOp:translate = (-2, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "Tube"
    {
        double height = 2
        double radius = 0.5
    }

    def Cone "Point"
    {
        double height = 2
        double radius = 0.5
        double3 xformOp:translate = (2, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Capsule "Pill"
    {
        double height = 1
        double radius = 0.25
        double3 xformOp:translate = (4, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
