<?xml version="1.0" encoding="utf-8"?>
<!--
  T17 Tests.ProviderHost.exe — the provider COM host harness (name frozen by
  T05/ADR-0010). It activates the built Preview3DThumbnailProvider.dll through
  the real Shell COM sequence without linking it (the two entry points are
  PRIVATE), drives parallel STA apartments, and runs the repeated load/unload
  leak loop.

  It also compiles the real provider orchestration (ThumbnailPipeline,
  GeometrySampler, CpuRasterizer, RasterBitmap) so a registered fixture can be
  rendered through the T14 sampler and T15 rasterizer and compared with its
  committed golden before the first family adapter lands. See
  tests/provider-host/README.md for the fixture workflow.
-->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>18.0</VCProjectVersion>
    <Keyword>Win32Proj</Keyword>
    <ProjectGuid>{6c2f9a10-7d3e-4b21-9f4a-2d8c1b7e5a64}</ProjectGuid>
    <RootNamespace>TestsProviderHost</RootNamespace>
  </PropertyGroup>
  <PropertyGroup Label="Vcpkg">
    <VcpkgEnableManifest>true</VcpkgEnableManifest>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <WholeProgramOptimization>true</WholeProgramOptimization>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings">
  </ImportGroup>
  <ImportGroup Label="Shared">
  </ImportGroup>
  <ImportGroup Label="PropertySheets" Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <ImportGroup Label="PropertySheets" Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <PropertyGroup Label="UserMacros" />
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>..\..\shared\model-core\include;..\..\shared\platform\include;..\..\shared\parser-core\include;..\..\thumbnail-provider;..\..\thumbnail-spike\rasterizer;..\..\import-worker\src;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!-- FASTGLTF_ENABLE_DEPRECATED_EXT=1 must match the vcpkg fastgltf static
           library's INTERFACE_COMPILE_DEFINITIONS (see the provider project). -->
      <PreprocessorDefinitions>PREVIEW3D_PROVIDER_DLL=LR"($(SolutionDir)$(Platform)\$(Configuration)\Preview3DThumbnailProvider.dll)";PREVIEW3D_PROVIDER_HOST_GOLDEN_DIR=LR"($(SolutionDir)tests\provider-host\goldens\\)";PREVIEW3D_FBX_FIXTURE_DIR=LR"($(SolutionDir)tests\fixtures\fbx-spike\\)";PREVIEW3D_3MF_FIXTURE_DIR=LR"($(SolutionDir)tests\fixtures\3mf-spike\\)";PREVIEW3D_USD_FIXTURE_DIR=LR"($(SolutionDir)tests\fixtures\usd-spike\\)";FASTGLTF_ENABLE_DEPRECATED_EXT=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalDependencies>ole32.lib;user32.lib;gdi32.lib;psapi.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <ClCompile>
      <PreprocessorDefinitions>_DEBUG;_CONSOLE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <PreprocessorDefinitions>NDEBUG;_CONSOLE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="ProviderHostMain.cpp" />
    <ClCompile Include="FixtureRegistry.cpp" />
    <!-- The real provider orchestration, compiled from the shipped sources so
         the golden path is the production pipeline, not a copy. -->
    <ClCompile Include="..\..\thumbnail-provider\ThumbnailPipeline.cpp" />
    <ClCompile Include="..\..\thumbnail-provider\FamilyAdapterRegistry.cpp" />
    <ClCompile Include="..\..\thumbnail-provider\StlFamilyAdapter.cpp" />
    <ClCompile Include="..\..\thumbnail-provider\PlyFamilyAdapter.cpp" />
    <ClCompile Include="..\..\thumbnail-provider\ObjFamilyAdapter.cpp" />
    <ClCompile Include="..\..\thumbnail-provider\GltfFamilyAdapter.cpp" />
    <ClCompile Include="..\..\thumbnail-provider\FbxFamilyAdapter.cpp" />
    <ClCompile Include="..\..\thumbnail-provider\ThreeMfFamilyAdapter.cpp" />
    <ClCompile Include="..\..\import-worker\src\ThreeMfOpcPreflight.cpp" />
    <ClCompile Include="..\..\thumbnail-provider\UsdFamilyAdapter.cpp">
      <!-- TinyUSDZ's prim-types.hh emits C4702 under /Od; vendored header. -->
      <DisableSpecificWarnings>4702;%(DisableSpecificWarnings)</DisableSpecificWarnings>
    </ClCompile>
    <ClCompile Include="..\..\import-worker\src\UsdZipPreflight.cpp" />
    <ClCompile Include="..\..\thumbnail-provider\GeometrySampler.cpp" />
    <ClCompile Include="..\..\thumbnail-provider\CpuRasterizer.cpp" />
    <ClCompile Include="..\..\thumbnail-provider\RasterBitmap.cpp" />
    <!-- T21: the shared parser subset StlAdapter.cpp consumes. -->
    <ClCompile Include="..\..\shared\parser-core\src\AsciiTokenizer.cpp" />
    <ClCompile Include="..\..\shared\parser-core\src\StlParserCore.cpp" />
    <ClCompile Include="..\..\shared\parser-core\src\PlyParserCore.cpp" />
    <ClCompile Include="ProviderHostTests.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="FixtureRegistry.h" />
    <ClInclude Include="GoldenImage.h" />
    <ClInclude Include="ProviderHostSupport.h" />
  </ItemGroup>
  <ItemGroup>
    <!-- Build-order only: the host loads the DLL at runtime, so it must exist
         and be current before Tests.ProviderHost.exe runs. Its only importable
         surface is the two PRIVATE COM entry points, resolved with
         GetProcAddress. -->
    <ProjectReference Include="..\..\thumbnail-provider\Preview3DThumbnailProvider.vcxproj">
      <Project>{0b5aa70c-f16a-42a1-95d1-73ad75d2fcbf}</Project>
      <LinkLibraryDependencies>false</LinkLibraryDependencies>
    </ProjectReference>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets">
  </ImportGroup>
</Project>