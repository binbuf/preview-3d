<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64"><Configuration>Debug</Configuration><Platform>x64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64"><Configuration>Release</Configuration><Platform>x64</Platform></ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>18.0</VCProjectVersion>
    <Keyword>Win32Proj</Keyword>
    <ProjectGuid>{A1B2C3D4-0004-4000-8000-000000000004}</ProjectGuid>
    <RootNamespace>GltfFuzz</RootNamespace>
  </PropertyGroup>
  <PropertyGroup Label="Vcpkg"><VcpkgEnableManifest>true</VcpkgEnableManifest></PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v145</PlatformToolset>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <EnableASAN>true</EnableASAN>
    <OutDir>$(MSBuildProjectDirectory)\x64\$(Configuration)\</OutDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>..\..\shared\platform\include;..\..\shared\model-core\include;..\..\import-worker\src;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!-- _DISABLE_STL_ANNOTATION: the pinned vcpkg decoders (fastgltf/simdjson/
           draco/meshoptimizer/ktx/libwebp) are static libraries built without
           ASan, so their STL headers emit detect_mismatch(annotate_*=0). An
           ASan-instrumented TU emits 1 and LNK2038 fails. ASan still instruments
           this target's product code (heap/stack/globals); only the asan
           container annotations are off to match the prebuilt closure. -->
      <PreprocessorDefinitions>FASTGLTF_ENABLE_DEPRECATED_EXT=1;_DISABLE_STL_ANNOTATION;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalOptions>/fsanitize=fuzzer %(AdditionalOptions)</AdditionalOptions>
      <BasicRuntimeChecks>Default</BasicRuntimeChecks>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <AdditionalDependencies>windowscodecs.lib;psapi.lib;ws2_32.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalOptions>/INFERASANLIBS %(AdditionalOptions)</AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="GltfFuzz.cpp" />
    <ClCompile Include="..\..\import-worker\src\GltfAdapter.cpp" />
    <ClCompile Include="..\..\import-worker\src\DracoDecodeAdapter.cpp" />
    <ClCompile Include="..\..\import-worker\src\MeshoptDecodeAdapter.cpp" />
    <ClCompile Include="..\..\import-worker\src\TextureTranscodeAdapter.cpp" />
    <ClCompile Include="..\..\import-worker\src\WebpDecodeAdapter.cpp" />
    <ClCompile Include="..\..\import-worker\src\WicImageDecodeAdapter.cpp" />
    <ClCompile Include="..\..\import-worker\src\ImageFormatSniff.cpp" />
    <ClCompile Include="..\..\import-worker\src\ChunkBatchSink.cpp" />
    <ClCompile Include="..\..\import-worker\src\SidecarFileClient.cpp" />
    <ClCompile Include="..\..\shared\model-core\src\ControlChannelIo.cpp" />
    <ClCompile Include="..\..\shared\model-core\src\MappedFile.cpp" />
    <ClCompile Include="..\..\shared\platform\src\MappedView.cpp" />
  </ItemGroup>
  <Target Name="CopyAddressSanitizerRuntime" AfterTargets="Build">
    <Copy SourceFiles="$(VCToolsInstallDir)bin\Hostx64\x64\clang_rt.asan_dynamic-x86_64.dll"
          DestinationFolder="$(OutDir)" SkipUnchangedFiles="true"
          Condition="Exists('$(VCToolsInstallDir)bin\Hostx64\x64\clang_rt.asan_dynamic-x86_64.dll')" />
  </Target>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>