<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="CreateInstaller">
  <PropertyGroup>
    <!-- Avoid a quoted trailing backslash in Exec command lines. -->
    <RepositoryRoot>$(MSBuildThisFileDirectory)..</RepositoryRoot>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <InstallerTimestampUrl Condition="'$(InstallerTimestampUrl)' == ''">https://timestamp.digicert.com</InstallerTimestampUrl>
  </PropertyGroup>

  <Target Name="ValidateInstallerProperties">
    <Error Condition="'$(Configuration)' != 'Release'"
           Text="CreateInstaller only supports Configuration=Release." />
    <Error Condition="'$(Platform)' != 'x64'"
           Text="CreateInstaller only supports Platform=x64." />
  </Target>

  <Target Name="BuildInstallerInputs"
          DependsOnTargets="ValidateInstallerProperties">
    <!-- The viewer reference builds and deploys the worker first. Tests,
         thumbnail provider, and compatibility host are intentionally absent. -->
    <MSBuild Projects="$(RepositoryRoot)\interactive-viewer\Preview3D.vcxproj"
             Targets="Build"
             Properties="Configuration=Release;Platform=x64;SolutionDir=$(RepositoryRoot)\"
             BuildInParallel="false" />
  </Target>

  <Target Name="CreateInstaller"
          DependsOnTargets="BuildInstallerInputs">
    <Exec Command="powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)installer\Create-Installer.ps1&quot; -RepositoryRoot &quot;$(RepositoryRoot)&quot; -CertificateThumbprint &quot;$(InstallerSigningThumbprint)&quot; -TimestampUrl &quot;$(InstallerTimestampUrl)&quot; -NsisPath &quot;$(NsisPath)&quot; -SkipBuild" />
  </Target>
</Project>
